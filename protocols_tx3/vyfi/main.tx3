// VyFi DEX — AMM Order Submission Protocol
//
// Two-step DEX model:
// 1. User submits order → sends funds + datum to order script address (no scripts executed)
// 2. Batcher processes order → consumes order + pool, distributes results (VyFi infra)
//
// This tx3 implements the USER-FACING transactions only (step 1 + cancel).
// Each pool has its own order address — provided per-call as a dynamic party.
//
// Pool data source: GET https://api.vyfi.io/lp?networkId=1

// --- Parties ---

// The user submitting the order
party User;

// Order script address (per-pool, provided per-call)
party OrderScript;

// --- Environment ---

env {
    // Process fee charged by VyFi batchers (1.9 ADA)
    process_fee: Int,
}

// --- Types ---

// Order datum submitted to the order script address
// On-chain: Constr(0, [Bytes, OrderType])
type OrderDatum {
    // User's payment credential (28 bytes) + staking credential (28 bytes)
    user_creds: Bytes,
    // Order type (swap, add/remove liquidity)
    order_type: OrderType,
}

// --- Order Type variants ---
// Constructor indices must match on-chain:
//   0 = AddLiquidity
//   1 = RemoveLiquidity
//   2 = (reserved/unknown)
//   3 = SwapAToB (ADA → Token)
//   4 = SwapBToA (Token → ADA)

type OrderType {
    AddLiquidity { min_lp_tokens: Int, },
    RemoveLiquidity { min_amounts: RemoveLiqMinAmounts, },
    OrderType2 {},
    SwapAToB { min_receive_b: Int, },
    SwapBToA { min_receive_a: Int, },
}

// Minimum amounts for remove liquidity
// On-chain: Constr(0, [Int, Int])
type RemoveLiqMinAmounts {
    min_ada: Int,
    min_token_b: Int,
}

// Redeemer spent on the per-pool order validator (only used by cancel).
//   Process — Constr(0, []) — batcher executes the order (VyFi infra, not here).
//   Cancel  — Constr(1, []) — owner reclaims their order. Verified against the
//             real cancel tx 34a41f7f (redeemer = Constr(1, [])).
type OrderRedeemer {
    Process,
    Cancel,
}

// --- Transactions ---

// Swap ADA for Token (A → B)
// User sends ADA to the order address with swap datum
tx swap_a_to_b(
    // User credentials: payment_cred (28 bytes) || stake_cred (28 bytes)
    user_creds: Bytes,
    // Amount of ADA (lovelace) to swap
    swap_amount: Int,
    // Minimum amount of token B to receive
    min_out: Int,
) {
    input* source {
        from: User,
        min_amount: Ada(swap_amount + process_fee) + fees,
    }

    output {
        to: OrderScript,
        amount: Ada(swap_amount + process_fee),
        datum: OrderDatum {
            user_creds: user_creds,
            order_type: OrderType::SwapAToB {
                min_receive_b: min_out,
            },
        },
    }

    output {
        to: User,
        amount: source - Ada(swap_amount + process_fee) - fees,
    }
}

// Swap Token for ADA (B → A)
// User sends tokens + min ADA to the order address with swap datum
tx swap_b_to_a(
    // User credentials: payment_cred (28 bytes) || stake_cred (28 bytes)
    user_creds: Bytes,
    // Token B policy ID
    token_policy: Bytes,
    // Token B asset name
    token_name: Bytes,
    // Amount of token B to swap
    token_amount: Int,
    // Minimum amount of ADA (lovelace) to receive
    min_out: Int,
    // Min-UTxO ADA buffer held in the order UTxO (the process fee is added from
    // env). On-chain this is a frontend/wallet choice — mostly 2_000_000, but it
    // varies per pool/wallet (1_050_000 .. 2_100_000 observed). It is NOT the
    // protocol's computed min_utxo (that would resolve to ~1.3M and diverge from
    // the dominant 3.9M order), so it stays a caller param. See README.
    order_min_ada: Int,
) {
    locals {
        swap_tokens: AnyAsset(token_policy, token_name, token_amount),
        // ADA attached to the order = min-UTxO buffer + the VyFi process fee
        // (env). Mirrors the ADA-side orders, which also add process_fee.
        order_ada: Ada(order_min_ada + process_fee),
    }

    input* source {
        from: User,
        min_amount: order_ada + swap_tokens + fees,
    }

    output {
        to: OrderScript,
        amount: order_ada + swap_tokens,
        datum: OrderDatum {
            user_creds: user_creds,
            order_type: OrderType::SwapBToA {
                min_receive_a: min_out,
            },
        },
    }

    output {
        to: User,
        amount: source - order_ada - swap_tokens - fees,
    }
}

// Add liquidity to a pool
// User sends ADA + tokens to the order address
tx add_liquidity(
    // User credentials: payment_cred (28 bytes) || stake_cred (28 bytes)
    user_creds: Bytes,
    // Amount of ADA (lovelace) to deposit
    ada_amount: Int,
    // Token B policy ID
    token_policy: Bytes,
    // Token B asset name
    token_name: Bytes,
    // Amount of token B to deposit
    token_amount: Int,
    // Minimum LP tokens to receive
    desired_lp: Int,
) {
    locals {
        deposit_tokens: AnyAsset(token_policy, token_name, token_amount),
    }

    input* source {
        from: User,
        min_amount: Ada(ada_amount + process_fee) + deposit_tokens + fees,
    }

    output {
        to: OrderScript,
        amount: Ada(ada_amount + process_fee) + deposit_tokens,
        datum: OrderDatum {
            user_creds: user_creds,
            order_type: OrderType::AddLiquidity {
                min_lp_tokens: desired_lp,
            },
        },
    }

    output {
        to: User,
        amount: source - Ada(ada_amount + process_fee) - deposit_tokens - fees,
    }
}

// Remove liquidity from a pool
// User sends LP tokens to the order address
tx remove_liquidity(
    // User credentials: payment_cred (28 bytes) || stake_cred (28 bytes)
    user_creds: Bytes,
    // LP token policy ID
    lp_policy: Bytes,
    // LP token asset name
    lp_name: Bytes,
    // Amount of LP tokens to burn
    lp_amount: Int,
    // Minimum ADA (lovelace) to receive back
    min_out_ada: Int,
    // Minimum token B to receive back
    min_out_token: Int,
    // Min-UTxO ADA buffer held in the order UTxO (process fee added from env).
    // Caller param for the same reason as in swap_b_to_a (frontend choice, not
    // derivable on-chain).
    order_min_ada: Int,
) {
    locals {
        lp_tokens: AnyAsset(lp_policy, lp_name, lp_amount),
        // ADA attached to the order = min-UTxO buffer + the VyFi process fee.
        order_ada: Ada(order_min_ada + process_fee),
    }

    input* source {
        from: User,
        min_amount: order_ada + lp_tokens + fees,
    }

    output {
        to: OrderScript,
        amount: order_ada + lp_tokens,
        datum: OrderDatum {
            user_creds: user_creds,
            order_type: OrderType::RemoveLiquidity {
                min_amounts: RemoveLiqMinAmounts {
                    min_ada: min_out_ada,
                    min_token_b: min_out_token,
                },
            },
        },
    }

    output {
        to: User,
        amount: source - order_ada - lp_tokens - fees,
    }
}

// Cancel a pending order
//
// The ONLY tx in this protocol that executes a script. It spends the user's own
// order UTxO at the per-pool order validator (PlutusV1) with the Cancel redeemer
// (Constr(1, [])) and returns the locked funds to the user. VyFi attaches no
// reference scripts, so the order validator is supplied inline as a witness.
//
// Verified against the real cancel tx 34a41f7f (ADA/SNEK pool):
//   - input: order UTxO at the order script, redeemer Constr(1, [])
//   - output 0: the order's full value back to the user
//   - output 1: change (user funding input - fee)
//   - collateral from the user, validity interval [since_slot, until_slot]
//
// Params:
//   order_utxo   — UtxoRef of the order to cancel (at the pool's order address).
//   order_script — the pool's order validator, PlutusV1 CBOR. These are the
//                  bytes whose blake2b-224 (with the 0x01 language tag) equals
//                  the order address' script hash — i.e. the doubly-wrapped
//                  script as returned by Koios `script_info.bytes` / the VyFi
//                  API (e.g. ADA/SNEK = 590a8c0100003323..., hash 2c0f418d...).
//   since_slot   — validity lower bound (invalid_before).
//   until_slot   — validity upper bound (invalid_after). The real cancel sets
//                  both bounds (a ~3h window); the validator needs the owner's
//                  signature, proven by spending the user's funding input.
tx cancel(
    order_utxo: UtxoRef,
    order_script: Bytes,
    since_slot: Int,
    until_slot: Int,
) {
    // The order being cancelled. Spent with the Cancel redeemer; its address
    // (= the order validator) is matched against the inline plutus_witness.
    input order_input {
        ref: order_utxo,
        datum_is: OrderDatum,
        redeemer: OrderRedeemer::Cancel {},
    }

    // User wallet — supplies fees and collateral, and receives the funds back.
    input* source {
        from: User,
        min_amount: fees,
    }

    // A script executes, so collateral is required.
    collateral {
        from: User,
        min_amount: fees,
    }

    // Time window of the cancel (matches the real tx, both bounds set).
    validity {
        since_slot: since_slot,
        until_slot: until_slot,
    }

    // Return the order's full value (ADA + tokens) to the user.
    output {
        to: User,
        amount: order_input,
    }

    // Change back to the user.
    output {
        to: User,
        amount: source - fees,
    }

    // Attach the order validator inline (VyFi uses no reference scripts).
    cardano::plutus_witness {
        version: 1,
        script: order_script,
    }
}
