// Indigo Protocol — Synthetic Assets (iAssets) on Cardano
// https://github.com/IndigoProtocol/indigo-smart-contracts
// https://github.com/IndigoProtocol/indigo-upgrade-details-v2 (VX source)
//
// Users deposit ADA as collateral in CDPs to mint synthetic assets
// (iUSD, iBTC, iETH, iSOL). Also supports Stability Pool deposits
// and INDY token staking. All contracts are PlutusV2.
//
// On-chain version mapping (as of 2026-04-07):
//   CDP validators:     VX (AdjustCDP has 3 fields, confirmed on-chain)
//   SP validator:       VX (request/process pattern with AccountAction)
//   Staking validator:  V1/V2 (empty datums Constr(0,[]), upgrade to VX pending)
//   Collector:          V2 (unchanged between versions)

// --- Parties ---

// The user interacting with the protocol
party User;

// CDP Spend validator (holds CDP UTxOs with user collateral + CDP NFT)
party CdpScript;

// CDP output address — per-user: script payment (CdpScript) + user's staking key
// On-chain these are addr1z... (type 0x11 = script + key staking)
// Must be provided per-call since each user has a different staking credential
party CdpUserAddr;

// CDP Creator validator (holds CDP_CREATOR auth tokens)
party CdpCreatorScript;

// Collector validator (accumulates protocol fees)
party CollectorScript;

// Stability Pool validator (holds iAsset deposits + pool state)
party StabilityPoolScript;

// INDY Staking validator (holds staked INDY tokens)
party StakingScript;

// Interest Collection validator (holds accumulated iAsset interest fees) — V3 only
party InterestCollectorScript;

// Pyth State withdraw validator — its REWARD account is withdrawn-from (amount 0) to run
// the Pyth price update. Fixed (one Pyth State). Used by price-checked CDP ops (withdraw/borrow).
party PythStateWithdraw;

// Per-iAsset Pyth FEED validator reward account — withdrawn-from (amount 0) to assert the
// derived price for THIS iAsset. Provided per-call (differs per iAsset).
party FeedValidator;

// Treasury validator (collects the debt-minting fee on borrow). UTxOs at addr1x form.
party TreasuryScript;

// --- Environment ---
// Instance-level config — same for all Indigo mainnet users.

env {
    // -- Minting policy IDs --
    iasset_policy_id: Bytes,                 // iAsset minting policy (iUSD, iBTC, etc.)
    cdp_nft_policy_id: Bytes,                // CDP NFT minting policy
    cdp_creator_policy_id: Bytes,            // CDP_CREATOR auth token policy
    staking_manager_nft_policy_id: Bytes,    // STAKING_MANAGER_NFT (singleton NFT)
    staking_position_policy_id: Bytes,       // STAKING_POSITION (minted/burned per position)
    indy_policy_id: Bytes,                   // INDY governance/staking token

    // -- Token names (hex) --
    cdp_nft_name: Bytes,                     // "CDP"
    cdp_creator_name: Bytes,                 // "CDP_CREATOR"
    staking_manager_nft_name: Bytes,         // "STAKING_MANAGER_NFT"
    staking_position_name: Bytes,            // "STAKING_POSITION"
    indy_name: Bytes,                        // "INDY"

    // -- Reference script UTxOs --
    cdp_spend_ref: UtxoRef,                  // CDP spend validator ref script
    cdp_creator_ref: UtxoRef,                // CDP creator validator ref script
    collector_ref: UtxoRef,                  // Collector validator ref script
    iasset_mint_ref: UtxoRef,                // iAsset minting policy ref script
    cdp_nft_mint_ref: UtxoRef,               // CDP NFT minting policy ref script
    stability_pool_ref: UtxoRef,             // Stability Pool validator ref script
    staking_ref: UtxoRef,                    // INDY Staking validator ref script
    staking_position_mint_ref: UtxoRef,      // STAKING_POSITION mint policy ref script
    interest_collection_ref: UtxoRef,        // Interest Collection validator ref script (V3)
    pyth_state_withdraw_ref: UtxoRef,         // Pyth State UTxO: carries the State NFT (data ref)
                                             // AND the Pyth-state-withdraw validator ref script
    treasury_ref: UtxoRef,                    // Treasury validator ref script (borrow only)
}

// --- Types ---

// CDP Datum — represents a Collateralized Debt Position.
// V3 on-chain: Constr(0, [Constr(0, [Maybe<PKH>, TokenName, AssetClass, Int, Constr(interest)])])
// Double-wrapped: outer Constr(0) = CDPDatum, inner Constr(0) = the 5 record fields.
// NEW in V3: a collateral AssetClass field at index 2 (multi-collateral support);
// ("","") = ADA. Confirmed vs on-chain CBOR (e.g. CDP output of tx 813eef7a…).
type CDPDatum {
    cdp_inner: CDPFields,
}

// Inner CDP fields (produces the inner Constr(0, [fields...]))
type CDPFields {
    cdp_owner: MaybePkh,
    cdp_iasset: Bytes,
    cdp_collateral_asset: AssetClass,
    cdp_minted_amount: Int,
    cdp_interest: CdpInterest,
}

// Maybe<PaymentPubKeyHash> — Nothing means CDP is frozen
type MaybePkh {
    JustPkh {
        value: Bytes,
    },
    NothingPkh,
}

// CDPFees — VX interest/fee tracking (variant type)
//   Constr(0) = ActiveCDPInterestTracking { lastSettled, unitaryInterestSnapshot }
//   Constr(1) = FrozenCDPAccumulatedFees { lovelacesTreasury, lovelacesIndyStakers }
type CdpInterest {
    ActiveTracking {
        timestamp: Int,
        accumulator: Int,
    },
    FrozenFees {
        treasury: Int,
        stakers: Int,
    },
}

// Oracle Datum — on-chain structure (read from oracle reference input)
// Constr(0, [nonce: Int, price: OnChainDecimal, expiration: POSIXTime])
// TX3 can read reference input datums via `datum_is` in reference blocks.
// Fields accessible as: oracle_data.od_nonce, oracle_data.od_price, oracle_data.od_expiration
// NOTE: timestamp_ms and interest_accumulator are NOT from this oracle — they are
// caller-provided values. The oracle is referenced for on-chain validator checks (price).
type OracleDatum {
    od_nonce: Int,
    od_price: OnChainDecimal,
    od_expiration: Int,
}

// OnChainDecimal — wrapper for decimal values (Constr(0, [Int]))
type OnChainDecimal {
    ocd_value: Int,
}

// OracleIdx — the trailing enum in the V3 AdjustCDP redeemer (price-oracle pointer).
// Confirmed against the v3 SDK (@indigo-labs/indigo-sdk 0.3.28, price-oracle/types-new.ts):
//   OracleRefInputIdx{idx} = Constr(0,[idx])  — idx = the price oracle's position in the
//                                                tx's reference_inputs (price-checked ops)
//   OracleOutputIdx{idx}   = Constr(1,[idx])
//   OracleVoid             = Constr(2,[])      — no price check (deposit collateral / repay)
// The SDK rule: `isMintOrWithdraw = debtAdjustment > 0 || collateralAdjustment < 0`
// selects OracleRefInputIdx{ref idx}; otherwise OracleVoid. So a real BORROW or a
// collateral WITHDRAW must pass OracleRefInputIdx{idx} (index-coupled to tx3's ref ordering);
// add-collateral and repay pass OracleVoid.
type OracleIdx {
    OracleRefInputIdx {
        ori_idx: Int,
    },
    OracleOutputIdx {
        oo_idx: Int,
    },
    OracleVoid,
}

// Pyth FEED validator redeemer — Constr(0, [price, auxiliaryData]) where price is a
// 2-int struct derived off-chain from the Pyth message, and auxiliaryData is unit C0[].
// Confirmed vs on-chain (1d4c0f85 reward redeemer C0[C0[100000000, 3075258], C0[]]).
type PythPrice {
    pp_a: Int,
    pp_b: Int,
}

type PythFeedRedeemer {
    pfr_price: PythPrice,
    pfr_aux: UnitDatum,
}

// Output reference — Constr(0, [txHash, index]) (Aiken-style; txid not double-wrapped).
type OutRef {
    or_txhash: Bytes,
    or_idx: Int,
}

// Treasury "collect debt-minting fee" redeemer — Constr(4, [assetClass, fee, 0, cdpOutRef]).
// Confirmed vs on-chain borrow 6b8e6d44… (variants 0-3 unconfirmed; only index 4 is built here).
type TreasuryRedeemer {
    TRV0,
    TRV1,
    TRV2,
    TRV3,
    TRCollect {
        trc_asset: AssetClass,
        trc_fee: Int,
        trc_zero: Int,
        trc_cdp_outref: OutRef,
    },
}

// Treasury output datum — Constr(0, [Constr0[treasuryInOutRef], cdpInOutRef]).
type TreasuryInWrap {
    tiw_ref: OutRef,
}

type TreasuryDatum {
    td_treasury_in: TreasuryInWrap,
    td_cdp_in: OutRef,
}

// CDP Redeemer — V3. AdjustCdp is [currentTime, debtAdjustment, collateralAdjustment,
// priceOracleIdx] (confirmed vs the v3 SDK cdp/types-new.ts). Redeemer index ordering
// (Close=1, RedeemCdp=2, FreezeCdp=3, MergeCdps=4, MergeAuxiliary=5, Liquidate=6,
// UpgradeVersion=8) matches the SDK — so a normal close uses CloseCdp(1); the frozen
// "close" seen on-chain at Constr(6) is actually a Liquidate.
type CDPRedeemer {
    AdjustCDP {
        a_current_time: Int,
        a_minted_change: Int,
        a_collateral_change: Int,
        a_price_oracle_idx: OracleIdx,
    },
    CloseCDP {
        c_current_time: Int,
    },
    RedeemCDP {
        r_current_time: Int,
    },
    FreezeCDP {
        f_current_time: Int,
    },
    MergeCDPs,          // 4
    MergeAuxiliary {
        main_merge_utxo_hash: Bytes,
        main_merge_utxo_idx: Int,
    },
    LiquidateCDP,       // 6
    UpdateAsset,        // 7
    UpgradeVersion,     // 8
}

// CDP Creator Redeemer
// On-chain: Constr(0, [owner_pkh, mint_amount, collateral, timestamp])
type CDPCreatorRedeemer {
    CreateCDP {
        owner_pkh: Bytes,
        mint_amount: Int,
        collateral: Int,
        timestamp: Int,
    },
}

// Collector Redeemer
type CollectorRedeemer {
    Collect,            // 0
}

// Unit datum — used by Collector and CDPCreator outputs
type UnitDatum {
}

// --- Shared Plutus Address (V3) ---
// On-chain a Cardano address is Constr(0, [paymentCredential, Maybe<StakingCredential>]).
// Used for the Stability Pool action output/close addresses (and CDP outputs in Phase 1B).
// A type cannot be named `Address` (tx3 primitive) — hence `PlutusAddress`.

// Payment / stake credential — Constr(0,[hash]) = PubKey, Constr(1,[hash]) = Script.
type Cred {
    CredKey {
        ck_hash: Bytes,
    },
    CredScript {
        cs_hash: Bytes,
    },
}

// StakingCredential = StakingHash(Credential) = Constr(0, [Credential]).
type StakeRef {
    StakeKeyHash {
        skh_cred: Cred,
    },
}

// Maybe<StakingCredential> — Just = Constr(0,[ref]), Nothing = Constr(1,[]).
type MaybeStake {
    StakeJust {
        sj_ref: StakeRef,
    },
    StakeNone,
}

type PlutusAddress {
    pa_payment: Cred,
    pa_stake: MaybeStake,
}

// Build a key-payment + key-stake address:
//   Constr(0, [Constr(0,[pkh]), Constr(0,[Constr(0,[Constr(0,[stake])])])])
fn owner_address(pkh: Bytes, stake_key: Bytes) -> PlutusAddress {
    PlutusAddress {
        pa_payment: Cred::CredKey {
            ck_hash: pkh,
        },
        pa_stake: MaybeStake::StakeJust {
            sj_ref: StakeRef::StakeKeyHash {
                skh_cred: Cred::CredKey {
                    ck_hash: stake_key,
                },
            },
        },
    }
}

// --- Stability Pool types (V3) ---

// AssetClass — Constr(0, [policyId, tokenName]); ("","") = ADA. Used as map keys.
type AssetClass {
    ac_policy: Bytes,
    ac_name: Bytes,
}

// On-chain decimal — Constr(0, [Int]) wrapper (fixed-point bignum).
type SPDecimal {
    spd_value: Int,
}

// V3 Stability Pool snapshot — Constr(0, [SPDecimal, SPDecimal, Int, Int]).
// Reshaped from VX's 5 flat ints: the two accumulators are now SPDecimal-wrapped,
// followed by epoch + scale plain ints.
type SPSnapshot {
    sps_p: SPDecimal,
    sps_d: SPDecimal,
    sps_epoch: Int,
    sps_scale: Int,
}

// AccountAction — V3 request types (confirmed vs on-chain CBOR 2026-06-24):
//   ActCreate = Constr(0,[])
//   ActAdjust = Constr(1,[amount, PlutusAddress])     (amount>0 deposit, <0 withdraw)
//   ActClose  = Constr(2,[PlutusAddress, lovelace])   (NOW 2 fields; addr is structured)
type AccountAction {
    ActCreate,
    ActAdjust {
        act_amount: Int,
        act_output_addr: PlutusAddress,
    },
    ActClose {
        act_close_addr: PlutusAddress,
        act_lovelace: Int,
    },
}

// Maybe<AccountAction> — Just = Constr(0,[action]), Nothing = Constr(1,[]).
type MaybeAction {
    JustAction {
        act_value: AccountAction,
    },
    NothingAction,
}

// Stability Datum — Constr(0) = pool state, Constr(1) = user account.
type StabilityDatum {
    PoolState {
        sp_content: PoolContent,
    },
    Account {
        acc_content: AccountContent,
    },
}

// V3 StabilityPoolContent — Constr(0, [iasset, snapshot, rewards]).
// `sp_rewards` is the per-collateral-asset reward bookkeeping map; modeled as a
// placeholder here (no Phase-1A tx constructs a pool — refined for close_cdp in Phase 1B).
type PoolContent {
    sp_iasset: Bytes,
    sp_snapshot: SPSnapshot,
    sp_rewards: List<Tuple<AssetClass, SPDecimal>>,
}

// V3 AccountContent — Constr(0, [owner, iasset, snapshot, deposits, request, createdAt]).
// Two NEW fields vs VX: `acc_deposits` (per-asset accrued map, idx 3) and
// `acc_created_at` POSIXTime (idx 5).
type AccountContent {
    acc_owner: Bytes,
    acc_iasset: Bytes,
    acc_snapshot: SPSnapshot,
    acc_deposits: List<Tuple<AssetClass, SPDecimal>>,
    acc_request: MaybeAction,
    acc_created_at: Int,
}

// Stability Pool Redeemer — V3 constructor meanings (confirmed vs on-chain):
//   0 = RequestAction(action)  — the only user-facing redeemer
//   1 = ProcessRequest, pool side   (batcher; not built here)
//   2 = ProcessRequest, account side (batcher; not built here)
//   3 = (record epoch / unconfirmed; not built here)
//   4 = LiquidateCDP [idx]   (used by close_cdp in Phase 1B)
type StabilityPoolRedeemer {
    SPRequestAction {
        sp_action: AccountAction,
    },
    SPProcessPool,
    SPProcessAccount,
    SPRecordEpoch,
    SPLiquidateCDP {
        sp_liq_idx: Int,
    },
}


// Staking Datum — V2/VX structured datums (confirmed via indigo-sdk
// src/types/indigo/staking.ts and real on-chain CreateStakingPosition CBOR).
// NOTE: Earlier investigation notes claimed "all staking datums are Constr(0,[])
// empty" — that was wrong. Datums are fully structured per V1/V2 source.
//
// StakingDatum = Constr(0, [StakingManagerContent])   -- Manager variant
//              | Constr(1, [StakingPositionContent])  -- Position variant
type StakingDatum {
    StakingManager {
        sm_content: StakingManagerContent,
    },
    StakingPosition {
        sp_content: StakingPositionContent,
    },
}

// StakingManagerContent — Constr(0, [totalStake, managerSnapshot])
type StakingManagerContent {
    st_total_stake: Int,
    st_manager_snapshot: RewardSnapshot,
}

// StakingPositionContent — Constr(0, [owner, lockedAmount, positionSnapshot])
// lockedAmount is an association LIST of (PollId, LockedEntry) pairs — confirmed
// against raw on-chain CBOR (2026-06-24): empty = `80` (empty array), populated =
// `[ [pollId, Constr0[vote, end]] ]`. NOT a Plutus Map (`a0`/`a1`). Modeled with
// tx3 tuples (#341): outer entry = Tuple<Int, LockedEntry> (lowers to a 2-array),
// inner LockedEntry = record (lowers to Constr0[Int, Int]).
type StakingPositionContent {
    st_owner: Bytes,
    st_locked_amount: List<Tuple<Int, LockedEntry>>,
    st_position_snapshot: RewardSnapshot,
}

// RewardSnapshot — Constr(0, [snapshotAda])
type RewardSnapshot {
    rs_snapshot_ada: Int,
}

// LockedEntry — on-chain: Constr0[voteAmount: Int, endTime: POSIXTime].
// A record (Constr0[Int, Int]); used as the value half of each lockedAmount tuple.
type LockedEntry {
    le_vote_amount: Int,
    le_end_time: Int,
}

// Staking Redeemer — V2/VX (Unlock removed, UpgradeVersion moved to 6)
type StakingRedeemer {
    StCreateStakingPosition {
        st_pkh: Bytes,
    },
    StUpdateTotalStake,     // 1
    StDistribute,           // 2
    StAdjustStakedAmount {
        st_amount: Int,
    },
    StUnstake,              // 4
    StLock,                 // 5
    StUpgradeVersion,       // 6 (was Unlock=6, UpgradeVersion=7 in V1)
}

// --- Transactions ---

// ============================================================
// CDP TRANSACTIONS (V3)
// ============================================================
// adjust_cdp_mint / adjust_cdp_burn / close_cdp are implemented below (V3, live-verified
// against the @indigo-labs/indigo-sdk 0.3.28 source + real on-chain txs): they spend the
// CDP at the ff0b10bf validator + the Interest Collection validator (2cac220a78), settling
// accrued interest to the collector. All datum/redeemer values stay < u64.
//
// SCOPE NOTE — these cover the SAFE CDP operations (deposit collateral, repay debt, close):
//   • adjust_cdp_mint models DEPOSIT-collateral (debtAdjustment = 0): OracleVoid, no
//     treasury. A real BORROW (debtAdjustment > 0) additionally needs the Treasury (a
//     debt-minting fee) + a price-oracle ref with OracleRefInputIdx{idx} — see create_cdp.
//   • adjust_cdp_burn models REPAY (no collateral withdrawal): OracleVoid. A collateral
//     WITHDRAW (collateralAdjustment < 0) needs a price-oracle ref + OracleRefInputIdx{idx}
//     (the caller passes the oracle's index in the reference_inputs).
//   • close_cdp is the normal active close (CloseCdp redeemer) — verified vs on-chain tx
//     37783f745c0d…; it needs no treasury / price oracle / SP.
//
// create_cdp is NOT implemented — V3 makes it substantially more complex than tx3 can
// faithfully express (verdict in investigation/v3-findings.md §CDP): it consumes the
// Treasury, runs withdrawal-purpose ("reward") validators incl. a Pyth price proof, and
// uses an 11-field CDP-Creator redeemer whose trailing values are 3 output indices + 3
// reference-input indices that must match the tx's exact ordering — tx3 cannot guarantee
// that index coupling. (Liquidation/frozen-close paths also co-spend the unencodable SP.)
// ============================================================

// ============================================================
// 1. ADJUST CDP — MINT [V3 on-chain — AdjustCDP + Interest Collection]
// ============================================================
// Borrow more iAsset against a CDP and/or add ADA collateral. Every adjust settles the
// accrued interest: a portion of iAsset is minted to the Interest Collector and the
// CDP's debt grows accordingly. Confirmed vs on-chain tx 813eef7a… (add-collateral with
// interest capitalization) — the CDP spend redeemer is AdjustCDP[ts, minted_change,
// collateral_change, CKAda], co-spent with the Interest Collector (redeemer Collect).
//
// The caller computes the off-chain values (interest accrual, new totals, accumulator)
// and passes them: `mint_to_user` = iAsset the user receives (new borrow), `interest_fee`
// = iAsset minted to the collector, `minted_change`/`collateral_change` = the redeemer's
// requested deltas, `new_minted_total`/`new_collateral` = the updated CDP datum/value.
/// Adjust a CDP by borrowing more iAsset and/or adding ADA collateral. Settles accrued
/// interest to the protocol's interest collector and updates the CDP datum.
tx adjust_cdp_mint(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    cdp_utxo: UtxoRef,
    collector_utxo: UtxoRef,
    minted_change: Int,
    collateral_change: Int,
    mint_to_user: Int,
    interest_fee: Int,
    new_minted_total: Int,
    new_collateral: Int,
    timestamp_ms: Int,
    accumulator: Int,
    oracle_utxo: UtxoRef,
    iasset_config_utxo: UtxoRef,
    iasset_state_utxo: UtxoRef,
    price_oracle_idx: OracleIdx,
) {
    locals {
        cdp_nft: AnyAsset(cdp_nft_policy_id, cdp_nft_name, 1),
        total_mint: AnyAsset(iasset_policy_id, iasset_name, mint_to_user + interest_fee),
        collector_fee: AnyAsset(iasset_policy_id, iasset_name, interest_fee),
        user_iasset: AnyAsset(iasset_policy_id, iasset_name, mint_to_user),
        ada_asset: AssetClass {
            ac_policy: "",
            ac_name: "",
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference cdp_spend_script {
        ref: cdp_spend_ref,
    }

    reference interest_collection_script {
        ref: interest_collection_ref,
    }

    reference iasset_mint_script {
        ref: iasset_mint_ref,
    }

    // Read-only data reference inputs: oracle price, iAsset config, iAsset state.
    reference oracle_data {
        ref: oracle_utxo,
    }

    reference iasset_config {
        ref: iasset_config_utxo,
    }

    reference iasset_state {
        ref: iasset_state_utxo,
    }

    // Spend the CDP UTxO
    input cdp_input {
        ref: cdp_utxo,
        datum_is: CDPDatum,
        redeemer: CDPRedeemer::AdjustCDP {
            a_current_time: timestamp_ms,
            a_minted_change: minted_change,
            a_collateral_change: collateral_change,
            a_price_oracle_idx: price_oracle_idx,
        },
    }

    // Co-spend the Interest Collector UTxO (accumulates the interest fee)
    input collector_input {
        ref: collector_utxo,
        datum_is: UnitDatum,
        redeemer: CollectorRedeemer::Collect {},
    }

    // User provides any added collateral + fees
    input* source {
        from: User,
        min_amount: Ada(collateral_change) + fees,
    }

    // Mint iAsset: the user's new borrow + the interest fee
    mint {
        amount: total_mint,
        redeemer: UnitDatum {},
    }

    // Updated CDP UTxO
    output cdp_output {
        to: CdpUserAddr,
        amount: Ada(new_collateral) + cdp_nft,
        datum: CDPDatum {
            cdp_inner: CDPFields {
                cdp_owner: MaybePkh::JustPkh {
                    value: owner_pkh,
                },
                cdp_iasset: iasset_name,
                cdp_collateral_asset: ada_asset,
                cdp_minted_amount: new_minted_total,
                cdp_interest: CdpInterest::ActiveTracking {
                    timestamp: timestamp_ms,
                    accumulator: accumulator,
                },
            },
        },
    }

    // Return the Interest Collector with the accrued fee added
    output {
        to: InterestCollectorScript,
        amount: collector_input + collector_fee,
        datum: UnitDatum {},
    }

    // User gets the newly borrowed iAsset + change
    output {
        to: User,
        amount: source + cdp_input - Ada(new_collateral) - cdp_nft - fees + user_iasset,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 2. ADJUST CDP — BURN [V3 on-chain — repay debt + settle interest]
// ============================================================
// Repay iAsset debt (and optionally withdraw freed ADA collateral). The user provides
// the full repay amount; part is burned (debt reduction) and part settles the accrued
// interest to the Interest Collector. Confirmed vs on-chain tx 564ff734… (redeemer
// AdjustCDP[ts, minted_change, 0, CKAda]; user-provided iAsset split into burn + fee).
/// Adjust a CDP by repaying iAsset debt, optionally withdrawing freed ADA collateral.
/// Settles accrued interest to the protocol's interest collector.
tx adjust_cdp_burn(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    cdp_utxo: UtxoRef,
    collector_utxo: UtxoRef,
    minted_change: Int,
    collateral_change: Int,
    burn_amount: Int,
    interest_fee: Int,
    new_minted_total: Int,
    new_collateral: Int,
    timestamp_ms: Int,
    accumulator: Int,
    oracle_utxo: UtxoRef,
    iasset_config_utxo: UtxoRef,
    iasset_state_utxo: UtxoRef,
    price_oracle_idx: OracleIdx,
) {
    locals {
        cdp_nft: AnyAsset(cdp_nft_policy_id, cdp_nft_name, 1),
        iasset_to_burn: AnyAsset(iasset_policy_id, iasset_name, burn_amount),
        repay_total: AnyAsset(iasset_policy_id, iasset_name, burn_amount + interest_fee),
        collector_fee: AnyAsset(iasset_policy_id, iasset_name, interest_fee),
        ada_asset: AssetClass {
            ac_policy: "",
            ac_name: "",
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference cdp_spend_script {
        ref: cdp_spend_ref,
    }

    reference interest_collection_script {
        ref: interest_collection_ref,
    }

    reference iasset_mint_script {
        ref: iasset_mint_ref,
    }

    reference oracle_data {
        ref: oracle_utxo,
    }

    reference iasset_config {
        ref: iasset_config_utxo,
    }

    reference iasset_state {
        ref: iasset_state_utxo,
    }

    // Spend the CDP UTxO
    input cdp_input {
        ref: cdp_utxo,
        datum_is: CDPDatum,
        redeemer: CDPRedeemer::AdjustCDP {
            a_current_time: timestamp_ms,
            a_minted_change: minted_change,
            a_collateral_change: collateral_change,
            a_price_oracle_idx: price_oracle_idx,
        },
    }

    // Co-spend the Interest Collector UTxO
    input collector_input {
        ref: collector_utxo,
        datum_is: UnitDatum,
        redeemer: CollectorRedeemer::Collect {},
    }

    // User provides the repay iAsset (burn + interest fee) + fees
    input* source {
        from: User,
        min_amount: fees + repay_total,
    }

    // Burn the repaid debt portion
    burn {
        amount: iasset_to_burn,
        redeemer: UnitDatum {},
    }

    // Updated CDP UTxO (less debt, possibly less collateral)
    output cdp_output {
        to: CdpUserAddr,
        amount: Ada(new_collateral) + cdp_nft,
        datum: CDPDatum {
            cdp_inner: CDPFields {
                cdp_owner: MaybePkh::JustPkh {
                    value: owner_pkh,
                },
                cdp_iasset: iasset_name,
                cdp_collateral_asset: ada_asset,
                cdp_minted_amount: new_minted_total,
                cdp_interest: CdpInterest::ActiveTracking {
                    timestamp: timestamp_ms,
                    accumulator: accumulator,
                },
            },
        },
    }

    // Return the Interest Collector with the accrued fee added
    output {
        to: InterestCollectorScript,
        amount: collector_input + collector_fee,
        datum: UnitDatum {},
    }

    // User gets freed collateral (if withdrawing) + change
    output {
        to: User,
        amount: source + cdp_input - Ada(new_collateral) - cdp_nft - fees - repay_total,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 3. CLOSE CDP [V3 on-chain — CloseCdp; burn all debt + the CDP NFT]
// ============================================================
// Close an active CDP: burn ALL outstanding iAsset debt + the CDP NFT, settle the
// accrued interest to the Interest Collector, and return all ADA collateral to the user.
// Confirmed vs the v3 SDK closeCdp + on-chain tx 37783f745c0d… (CloseCdp redeemer
// C1[currentTime]). Needs NO treasury, NO price oracle, NO Stability Pool — just the
// interest oracle + collateral-asset state as DATA refs.
//
// `burn_amount` = the CDP's full debt (mintedAmt); `interest_fee` = accrued interest to
// the collector. The user provides burn_amount + interest_fee of the iAsset.
/// Close a CDP: burn all outstanding iAsset debt and the CDP NFT, settle accrued interest,
/// and recover all ADA collateral back to the user.
tx close_cdp(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    cdp_utxo: UtxoRef,
    collector_utxo: UtxoRef,
    burn_amount: Int,
    interest_fee: Int,
    timestamp_ms: Int,
    collateral_asset_utxo: UtxoRef,
    interest_oracle_utxo: UtxoRef,
) {
    locals {
        cdp_nft: AnyAsset(cdp_nft_policy_id, cdp_nft_name, 1),
        debt_to_burn: AnyAsset(iasset_policy_id, iasset_name, burn_amount),
        repay_total: AnyAsset(iasset_policy_id, iasset_name, burn_amount + interest_fee),
        collector_fee: AnyAsset(iasset_policy_id, iasset_name, interest_fee),
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference cdp_spend_script {
        ref: cdp_spend_ref,
    }

    reference cdp_nft_mint_script {
        ref: cdp_nft_mint_ref,
    }

    reference iasset_mint_script {
        ref: iasset_mint_ref,
    }

    reference interest_collection_script {
        ref: interest_collection_ref,
    }

    // Read-only DATA refs: collateral-asset state + interest oracle (no price oracle).
    reference collateral_asset_data {
        ref: collateral_asset_utxo,
    }

    reference interest_oracle_data {
        ref: interest_oracle_utxo,
    }

    // Spend the CDP UTxO (close it)
    input cdp_input {
        ref: cdp_utxo,
        datum_is: CDPDatum,
        redeemer: CDPRedeemer::CloseCDP {
            c_current_time: timestamp_ms,
        },
    }

    // Co-spend the Interest Collector UTxO (accrued interest)
    input collector_input {
        ref: collector_utxo,
        datum_is: UnitDatum,
        redeemer: CollectorRedeemer::Collect {},
    }

    // User provides the full repay (debt + interest) + fees
    input* source {
        from: User,
        min_amount: fees + repay_total,
    }

    // Burn the CDP NFT
    burn {
        amount: cdp_nft,
        redeemer: UnitDatum {},
    }

    // Burn all outstanding debt
    burn {
        amount: debt_to_burn,
        redeemer: UnitDatum {},
    }

    // Return the Interest Collector with the accrued fee added
    output {
        to: InterestCollectorScript,
        amount: collector_input + collector_fee,
        datum: UnitDatum {},
    }

    // User gets back all ADA collateral + iAsset change (the NFT is burned)
    output {
        to: User,
        amount: source + cdp_input - cdp_nft - fees - repay_total,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 4. WITHDRAW CDP — remove collateral [V3 on-chain — Pyth price check]
// ============================================================
// Withdraw ADA collateral from a CDP (debtAdjustment = 0, collateralAdjustment < 0).
// Because the iAsset is Pyth-priced, this runs the Pyth price check via TWO 0-amount
// withdrawals: the Pyth-state-update validator (redeemer = [pythMessage]) and the
// per-iAsset feed validator (redeemer = {derivedPrice, unit}). No treasury (no minting
// of new debt — only the accrued interest is minted to the collector). Structure derived
// from the v3 SDK adjustCdp/attachOracle + the on-chain borrow 6b8e6d44… reward validators.
//
// The caller supplies the Pyth message + the off-chain-derived price (a, b), the per-iAsset
// feed validator (its reward account `FeedValidator` + its ref script `feed_val_ref`), and
// the new datum totals. `collateral_change` is negative; `new_collateral` = old − withdrawn.
/// Withdraw ADA collateral from a CDP. Runs the Pyth price check (two withdrawal-validator
/// executions) and settles accrued interest. The caller provides the Pyth price message.
tx withdraw_cdp(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    cdp_utxo: UtxoRef,
    collector_utxo: UtxoRef,
    collateral_change: Int,
    interest_fee: Int,
    new_minted_total: Int,
    new_collateral: Int,
    timestamp_ms: Int,
    accumulator: Int,
    pyth_message: Bytes,
    feed_price_a: Int,
    feed_price_b: Int,
    feed_val_ref: UtxoRef,
    iasset_config_utxo: UtxoRef,
    collateral_asset_utxo: UtxoRef,
    interest_oracle_utxo: UtxoRef,
) {
    locals {
        cdp_nft: AnyAsset(cdp_nft_policy_id, cdp_nft_name, 1),
        interest_mint: AnyAsset(iasset_policy_id, iasset_name, interest_fee),
        ada_asset: AssetClass {
            ac_policy: "",
            ac_name: "",
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference cdp_spend_script {
        ref: cdp_spend_ref,
    }

    reference interest_collection_script {
        ref: interest_collection_ref,
    }

    reference iasset_mint_script {
        ref: iasset_mint_ref,
    }

    // Pyth State UTxO: the State NFT data ref + the state-withdraw validator ref script.
    reference pyth_state_ref {
        ref: pyth_state_withdraw_ref,
    }

    // Per-iAsset Pyth feed validator ref script.
    reference feed_ref {
        ref: feed_val_ref,
    }

    // iAsset config (the per-iAsset IAssetContent) — required by adjustCdp's reference set.
    reference iasset_config_data {
        ref: iasset_config_utxo,
    }

    reference collateral_asset_data {
        ref: collateral_asset_utxo,
    }

    reference interest_oracle_data {
        ref: interest_oracle_utxo,
    }

    // Spend the CDP UTxO (remove collateral; price-checked via the Pyth withdrawals below)
    input cdp_input {
        ref: cdp_utxo,
        datum_is: CDPDatum,
        redeemer: CDPRedeemer::AdjustCDP {
            a_current_time: timestamp_ms,
            a_minted_change: 0,
            a_collateral_change: collateral_change,
            a_price_oracle_idx: OracleIdx::OracleVoid {},
        },
    }

    // Co-spend the Interest Collector UTxO
    input collector_input {
        ref: collector_utxo,
        datum_is: UnitDatum,
        redeemer: CollectorRedeemer::Collect {},
    }

    // User provides fees (and collateral for the script execution)
    input* source {
        from: User,
        min_amount: fees,
    }

    // Mint the accrued interest (goes to the collector)
    mint {
        amount: interest_mint,
        redeemer: UnitDatum {},
    }

    // Pyth price check — withdrawal 1: run the Pyth state update.
    cardano::withdrawal {
        from: PythStateWithdraw,
        amount: 0,
        redeemer: [pyth_message],
    }

    // Pyth price check — withdrawal 2: assert the derived price for this iAsset.
    cardano::withdrawal {
        from: FeedValidator,
        amount: 0,
        redeemer: PythFeedRedeemer {
            pfr_price: PythPrice {
                pp_a: feed_price_a,
                pp_b: feed_price_b,
            },
            pfr_aux: UnitDatum {},
        },
    }

    // Updated CDP UTxO (less collateral, interest capitalized)
    output cdp_output {
        to: CdpUserAddr,
        amount: Ada(new_collateral) + cdp_nft,
        datum: CDPDatum {
            cdp_inner: CDPFields {
                cdp_owner: MaybePkh::JustPkh {
                    value: owner_pkh,
                },
                cdp_iasset: iasset_name,
                cdp_collateral_asset: ada_asset,
                cdp_minted_amount: new_minted_total,
                cdp_interest: CdpInterest::ActiveTracking {
                    timestamp: timestamp_ms,
                    accumulator: accumulator,
                },
            },
        },
    }

    // Return the Interest Collector with the accrued interest added
    output {
        to: InterestCollectorScript,
        amount: collector_input + interest_mint,
        datum: UnitDatum {},
    }

    // User gets back the withdrawn collateral + change
    output {
        to: User,
        amount: source + cdp_input - Ada(new_collateral) - cdp_nft - fees,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 5. BORROW CDP — mint more debt [V3 on-chain — Pyth price check + Treasury fee]
// ============================================================
// Borrow more iAsset against a CDP (debtAdjustment > 0). Adds the Treasury on top of the
// withdraw machinery: a debt-minting fee is paid to the Treasury (collected via a
// Constr(4) redeemer, returned with an OutRef-based datum), the accrued interest goes to
// the Interest Collector, and the rest of the newly minted iAsset goes to the user. The
// Pyth price is asserted via the two 0-amount withdrawals (same as withdraw_cdp).
// Confirmed structure vs on-chain borrow 6b8e6d44…. Total minted = debtAdjustment +
// interest; distribution: treasury_fee → Treasury, interest_fee → Collector,
// (debtAdjustment − treasury_fee) → user.
//
// Because tx3 can't decompose a UtxoRef into a datum, the caller passes the CDP and
// Treasury input txHash+index separately (used to build the OutRef datum/redeemer).
/// Borrow more iAsset against a CDP. Pays the debt-minting fee to the treasury, settles
/// accrued interest, and runs the Pyth price check. The caller provides the Pyth message.
tx borrow_cdp(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    cdp_utxo: UtxoRef,
    cdp_txhash: Bytes,
    cdp_idx: Int,
    collector_utxo: UtxoRef,
    treasury_utxo: UtxoRef,
    treasury_txhash: Bytes,
    treasury_idx: Int,
    debt_adjustment: Int,
    treasury_fee: Int,
    interest_fee: Int,
    new_minted_total: Int,
    new_collateral: Int,
    timestamp_ms: Int,
    accumulator: Int,
    pyth_message: Bytes,
    feed_price_a: Int,
    feed_price_b: Int,
    feed_val_ref: UtxoRef,
    iasset_config_utxo: UtxoRef,
    collateral_asset_utxo: UtxoRef,
    interest_oracle_utxo: UtxoRef,
) {
    locals {
        cdp_nft: AnyAsset(cdp_nft_policy_id, cdp_nft_name, 1),
        total_mint: AnyAsset(iasset_policy_id, iasset_name, debt_adjustment + interest_fee),
        treasury_fee_asset: AnyAsset(iasset_policy_id, iasset_name, treasury_fee),
        collector_fee: AnyAsset(iasset_policy_id, iasset_name, interest_fee),
        user_iasset: AnyAsset(iasset_policy_id, iasset_name, debt_adjustment - treasury_fee),
        ada_asset: AssetClass {
            ac_policy: "",
            ac_name: "",
        },
        iasset_class: AssetClass {
            ac_policy: iasset_policy_id,
            ac_name: iasset_name,
        },
        cdp_outref: OutRef {
            or_txhash: cdp_txhash,
            or_idx: cdp_idx,
        },
        treasury_in_outref: OutRef {
            or_txhash: treasury_txhash,
            or_idx: treasury_idx,
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference cdp_spend_script {
        ref: cdp_spend_ref,
    }

    reference interest_collection_script {
        ref: interest_collection_ref,
    }

    reference iasset_mint_script {
        ref: iasset_mint_ref,
    }

    reference treasury_script {
        ref: treasury_ref,
    }

    reference pyth_state_ref {
        ref: pyth_state_withdraw_ref,
    }

    reference feed_ref {
        ref: feed_val_ref,
    }

    // iAsset config (the per-iAsset IAssetContent) — required by adjustCdp's reference set.
    reference iasset_config_data {
        ref: iasset_config_utxo,
    }

    reference collateral_asset_data {
        ref: collateral_asset_utxo,
    }

    reference interest_oracle_data {
        ref: interest_oracle_utxo,
    }

    // Spend the CDP UTxO (increase debt)
    input cdp_input {
        ref: cdp_utxo,
        datum_is: CDPDatum,
        redeemer: CDPRedeemer::AdjustCDP {
            a_current_time: timestamp_ms,
            a_minted_change: debt_adjustment,
            a_collateral_change: 0,
            a_price_oracle_idx: OracleIdx::OracleVoid {},
        },
    }

    // Co-spend the Interest Collector
    input collector_input {
        ref: collector_utxo,
        datum_is: UnitDatum,
        redeemer: CollectorRedeemer::Collect {},
    }

    // Spend a Treasury UTxO (collect the debt-minting fee)
    input treasury_input {
        ref: treasury_utxo,
        datum_is: UnitDatum,
        redeemer: TreasuryRedeemer::TRCollect {
            trc_asset: iasset_class,
            trc_fee: treasury_fee,
            trc_zero: 0,
            trc_cdp_outref: cdp_outref,
        },
    }

    // User provides fees (and collateral for the script execution)
    input* source {
        from: User,
        min_amount: fees,
    }

    // Mint: the user's new debt + the accrued interest
    mint {
        amount: total_mint,
        redeemer: UnitDatum {},
    }

    // Pyth price check — two 0-amount withdrawals.
    cardano::withdrawal {
        from: PythStateWithdraw,
        amount: 0,
        redeemer: [pyth_message],
    }

    cardano::withdrawal {
        from: FeedValidator,
        amount: 0,
        redeemer: PythFeedRedeemer {
            pfr_price: PythPrice {
                pp_a: feed_price_a,
                pp_b: feed_price_b,
            },
            pfr_aux: UnitDatum {},
        },
    }

    // Updated CDP UTxO (more debt)
    output cdp_output {
        to: CdpUserAddr,
        amount: Ada(new_collateral) + cdp_nft,
        datum: CDPDatum {
            cdp_inner: CDPFields {
                cdp_owner: MaybePkh::JustPkh {
                    value: owner_pkh,
                },
                cdp_iasset: iasset_name,
                cdp_collateral_asset: ada_asset,
                cdp_minted_amount: new_minted_total,
                cdp_interest: CdpInterest::ActiveTracking {
                    timestamp: timestamp_ms,
                    accumulator: accumulator,
                },
            },
        },
    }

    // Return the Interest Collector with the accrued interest
    output {
        to: InterestCollectorScript,
        amount: collector_input + collector_fee,
        datum: UnitDatum {},
    }

    // Return the Treasury with the debt-minting fee + the OutRef continuity datum
    output {
        to: TreasuryScript,
        amount: treasury_input + treasury_fee_asset,
        datum: TreasuryDatum {
            td_treasury_in: TreasuryInWrap {
                tiw_ref: treasury_in_outref,
            },
            td_cdp_in: cdp_outref,
        },
    }

    // User gets the newly borrowed iAsset (debt − treasury fee) + change
    output {
        to: User,
        amount: source + cdp_input - Ada(new_collateral) - cdp_nft - fees + user_iasset,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// STABILITY POOL TRANSACTIONS (create / adjust / close account)
// ============================================================
// ⚠ BLOCKED BY A tx3 LIMITATION — the datum SHAPES below are correct & TIR-verified
// against V3 on-chain CBOR, but the VALUES cannot be built: the SP snapshot carries
// 18-decimal fixed-point accumulators that routinely exceed u64::MAX (real on-chain
// 'd' = 381e18 ≈ 3.8e20; adjust accounts reach 6.5e25). tx3's `IntoData for i128`
// does `Int::try_from(i128).unwrap()` (pallas `Int` is u64-bounded) and PANICS on any
// integer > u64::MAX — it never emits CBOR bignums. So these txs resolve (HTTP 502 /
// panic) for any realistic deposit; only deposits ≤ 18 raw units would fit. They are
// kept here (structurally faithful to V3) and will become usable if tx3 adds bignum
// support. Evidence: investigation/v3-findings.md §SP + comparison-report.md.
// ============================================================

// ============================================================
// 4. CREATE STABILITY POOL ACCOUNT [V3 on-chain — plain build, no script spend]
// ============================================================
// V3: opening an account is a PLAIN BUILD tx — the user locks their iAsset deposit
// + the account-create fee at the SP address with an Account datum carrying
// acc_request = Just(ActCreate). NO script is spent, NO token is minted, and the
// Collector is NOT involved (the batcher mints the SP_ACCOUNT token + updates the
// pool later, in the process step). Confirmed vs on-chain tx 85b683ed….
//
// `account_lovelace` is the ADA to lock in the account (accountCreateFee 5_000_000
// plus a min-UTxO buffer). The initial snapshot is caller-provided.
/// [BLOCKED — tx3 cannot encode the >u64 snapshot decimals; errors for realistic
/// deposits] Open a Stability Pool account: lock iAsset tokens plus the account-create
/// fee with a pending Create request. A batcher processes it (minting the token) later.
tx create_sp_account(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    deposit_amount: Int,
    account_lovelace: Int,
    snap_p: Int,
    snap_d: Int,
    snap_epoch: Int,
    snap_scale: Int,
) {
    locals {
        iasset_deposit: AnyAsset(iasset_policy_id, iasset_name, deposit_amount),
        new_snapshot: SPSnapshot {
            sps_p: SPDecimal {
                spd_value: snap_p,
            },
            sps_d: SPDecimal {
                spd_value: snap_d,
            },
            sps_epoch: snap_epoch,
            sps_scale: snap_scale,
        },
    }

    // User provides the iAsset deposit + the account ADA + fees
    input* source {
        from: User,
        min_amount: Ada(account_lovelace) + fees + iasset_deposit,
    }

    // New account UTxO at the SP address — pending Create request, empty deposits.
    output account_output {
        to: StabilityPoolScript,
        amount: Ada(account_lovelace) + iasset_deposit,
        datum: StabilityDatum::Account {
            acc_content: AccountContent {
                acc_owner: owner_pkh,
                acc_iasset: iasset_name,
                acc_snapshot: new_snapshot,
                acc_deposits: [],
                acc_request: MaybeAction::JustAction {
                    act_value: AccountAction::ActCreate {},
                },
                acc_created_at: 0,
            },
        },
    }

    // User change
    output {
        to: User,
        amount: source - Ada(account_lovelace) - fees - iasset_deposit,
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 5. ADJUST STABILITY POOL ACCOUNT [V3 on-chain — RequestAction(Adjust)]
// ============================================================
// User requests an adjustment (deposit or withdraw) to their SP account: spends the
// account UTxO and rewrites it with acc_request = Just(ActAdjust { amount, addr }).
// V3 does NOT consume the Collector. `deposit_change` is signed (>0 deposit, <0
// withdraw). The output address (where the batcher returns funds) is built from the
// owner's payment + stake key. Confirmed vs on-chain tx e135782e…/83424896….
//
// Because tx3 cannot field-access a spent variant input's datum, the caller passes
// the account's current owner/iasset/snapshot/deposits/created_at to preserve them.
/// [BLOCKED — tx3 cannot encode the >u64 snapshot decimals it must preserve] Request a
/// deposit to or withdrawal from a Stability Pool account (a batcher processes it).
/// Positive amount deposits, negative withdraws.
tx adjust_sp_account(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    deposit_change: Int,
    out_pkh: Bytes,
    out_stake: Bytes,
    account_utxo: UtxoRef,
    snap_p: Int,
    snap_d: Int,
    snap_epoch: Int,
    snap_scale: Int,
    deposits: List<Tuple<AssetClass, SPDecimal>>,
    created_at: Int,
) {
    locals {
        out_address: owner_address(out_pkh, out_stake),
        acc_snapshot: SPSnapshot {
            sps_p: SPDecimal {
                spd_value: snap_p,
            },
            sps_d: SPDecimal {
                spd_value: snap_d,
            },
            sps_epoch: snap_epoch,
            sps_scale: snap_scale,
        },
    }

    reference sp_script {
        ref: stability_pool_ref,
    }

    // Spend Account UTxO (set its pending request to Adjust)
    input account_input {
        ref: account_utxo,
        datum_is: StabilityDatum,
        redeemer: StabilityPoolRedeemer::SPRequestAction {
            sp_action: AccountAction::ActAdjust {
                act_amount: deposit_change,
                act_output_addr: out_address,
            },
        },
    }

    // User provides ADA for fees
    input* source {
        from: User,
        min_amount: fees,
    }

    // Updated Account UTxO — same value, acc_request set to Adjust, rest preserved.
    output account_output {
        to: StabilityPoolScript,
        amount: account_input,
        datum: StabilityDatum::Account {
            acc_content: AccountContent {
                acc_owner: owner_pkh,
                acc_iasset: iasset_name,
                acc_snapshot: acc_snapshot,
                acc_deposits: deposits,
                acc_request: MaybeAction::JustAction {
                    act_value: AccountAction::ActAdjust {
                        act_amount: deposit_change,
                        act_output_addr: out_address,
                    },
                },
                acc_created_at: created_at,
            },
        },
    }

    // User change
    output {
        to: User,
        amount: source - fees,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 6. CLOSE STABILITY POOL ACCOUNT [V3 on-chain — RequestAction(Close)]
// ============================================================
// User requests closure of their SP account: spends the account UTxO and rewrites it
// with acc_request = Just(ActClose { addr, lovelace }). The batcher later burns the
// account token and returns the deposit + rewards to `addr`. V3 ActClose carries TWO
// fields (a structured address + a lovelace amount). No Collector. Confirmed vs
// on-chain tx 3d19c13f… (close_lovelace observed = 2_000_000).
//
// As with adjust, the caller passes the account's current snapshot/deposits/created_at
// to preserve them (tx3 can't read a spent variant input's datum fields).
/// [BLOCKED — tx3 cannot encode the >u64 snapshot decimals it must preserve] Request
/// closure of a Stability Pool account; a batcher returns the deposit and rewards to
/// the given address.
tx close_sp_account(
    owner_pkh: Bytes,
    iasset_name: Bytes,
    out_pkh: Bytes,
    out_stake: Bytes,
    close_lovelace: Int,
    account_utxo: UtxoRef,
    snap_p: Int,
    snap_d: Int,
    snap_epoch: Int,
    snap_scale: Int,
    deposits: List<Tuple<AssetClass, SPDecimal>>,
    created_at: Int,
) {
    locals {
        out_address: owner_address(out_pkh, out_stake),
        acc_snapshot: SPSnapshot {
            sps_p: SPDecimal {
                spd_value: snap_p,
            },
            sps_d: SPDecimal {
                spd_value: snap_d,
            },
            sps_epoch: snap_epoch,
            sps_scale: snap_scale,
        },
    }

    reference sp_script {
        ref: stability_pool_ref,
    }

    // Spend Account UTxO (set its pending request to Close)
    input account_input {
        ref: account_utxo,
        datum_is: StabilityDatum,
        redeemer: StabilityPoolRedeemer::SPRequestAction {
            sp_action: AccountAction::ActClose {
                act_close_addr: out_address,
                act_lovelace: close_lovelace,
            },
        },
    }

    // User provides ADA for fees
    input* source {
        from: User,
        min_amount: fees,
    }

    // Updated Account UTxO — same value, acc_request set to Close, rest preserved.
    output account_output {
        to: StabilityPoolScript,
        amount: account_input,
        datum: StabilityDatum::Account {
            acc_content: AccountContent {
                acc_owner: owner_pkh,
                acc_iasset: iasset_name,
                acc_snapshot: acc_snapshot,
                acc_deposits: deposits,
                acc_request: MaybeAction::JustAction {
                    act_value: AccountAction::ActClose {
                        act_close_addr: out_address,
                        act_lovelace: close_lovelace,
                    },
                },
                acc_created_at: created_at,
            },
        },
    }

    // User change
    output {
        to: User,
        amount: source - fees,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 7. CREATE STAKING POSITION [V2/VX on-chain — confirmed via indigo-sdk]
// ============================================================
// Stake INDY tokens to earn protocol fee rewards (ADA).
// Consumes: Staking Manager UTxO (continuity — totalStake increases).
// Mints:    +1 STAKING_POSITION NFT authenticating the new position.
//
// Reference: indigo-sdk src/contracts/staking.ts :: openPosition
//
// Caller must read the current Staking Manager datum off-chain and pass:
//   - old_total_stake: current StakingManagerContent.totalStake
//   - current_snapshot_ada: current managerSnapshot.snapshotAda
// The new position's positionSnapshot is initialised to the same snapshot,
// so the user starts earning rewards from now.
/// Open an INDY staking position: stake INDY tokens and mint a STAKING_POSITION NFT,
/// increasing the manager's total stake, to start earning ADA fee rewards.
tx create_staking(
    owner_pkh: Bytes,
    indy_amount: Int,
    manager_utxo: UtxoRef,
    old_total_stake: Int,
    current_snapshot_ada: Int,
) {
    locals {
        indy_tokens: AnyAsset(indy_policy_id, indy_name, indy_amount),
        staking_position_nft: AnyAsset(staking_position_policy_id, staking_position_name, 1),
        current_snapshot: RewardSnapshot {
            rs_snapshot_ada: current_snapshot_ada,
        },
    }

    reference staking_script {
        ref: staking_ref,
    }

    reference staking_position_mint_script {
        ref: staking_position_mint_ref,
    }

    // Spend Staking Manager UTxO (continuity — updated totalStake)
    input manager_input {
        ref: manager_utxo,
        datum_is: StakingDatum,
        redeemer: StakingRedeemer::StCreateStakingPosition {
            st_pkh: owner_pkh,
        },
    }

    // User provides INDY tokens + ADA for fees + min UTxO for position + minUTxO for change
    input* source {
        from: User,
        min_amount: fees + indy_tokens + min_utxo(position_output) + min_utxo(change_output),
    }

    // Mint +1 STAKING_POSITION NFT (authenticates the new position UTxO)
    mint {
        amount: staking_position_nft,
        redeemer: UnitDatum {},
    }

    // Updated Staking Manager — same assets, totalStake increased by indy_amount,
    // snapshot unchanged (it only moves forward on Distribute).
    output manager_output {
        to: StakingScript,
        amount: manager_input,
        datum: StakingDatum::StakingManager {
            sm_content: StakingManagerContent {
                st_total_stake: old_total_stake + indy_amount,
                st_manager_snapshot: current_snapshot,
            },
        },
    }

    // New Staking Position — owner, empty lockedAmount list, snapshot = manager's current.
    output position_output {
        to: StakingScript,
        amount: min_utxo(position_output) + indy_tokens + staking_position_nft,
        datum: StakingDatum::StakingPosition {
            sp_content: StakingPositionContent {
                st_owner: owner_pkh,
                st_locked_amount: [],
                st_position_snapshot: current_snapshot,
            },
        },
    }

    // User change
    output change_output {
        to: User,
        amount: source - fees - indy_tokens - min_utxo(position_output),
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 8. ADJUST STAKING POSITION [V3 on-chain — structured datums, Manager co-spent]
// ============================================================
// Add or remove INDY from an existing staking position. V3 co-spends BOTH the
// Staking Manager (redeemer StUpdateTotalStake) and the Position (redeemer
// StAdjustStakedAmount{delta}); the manager's totalStake moves by the same delta.
// Both UTxOs carry structured datums (confirmed vs on-chain CBOR, e.g. tx
// 21cdb9dc…/c624c13a…). The Collector validator is NOT involved.
//
// `adjust_amount` is signed: > 0 deposits INDY, < 0 withdraws it. The caller must
// pass the manager's current totalStake + snapshotAda and the position's current
// lockedAmount (preserved unchanged; empty list `[]` in the common no-vote case).
/// Add or remove INDY from an existing staking position. Co-updates the staking
/// manager's total stake. Positive amount deposits INDY, negative withdraws it.
tx adjust_staking(
    owner_pkh: Bytes,
    indy_asset_name: Bytes,
    adjust_amount: Int,
    manager_utxo: UtxoRef,
    position_utxo: UtxoRef,
    old_total_stake: Int,
    snapshot_ada: Int,
    position_locked: List<Tuple<Int, LockedEntry>>,
) {
    locals {
        indy_change: AnyAsset(indy_policy_id, indy_asset_name, adjust_amount),
        current_snapshot: RewardSnapshot {
            rs_snapshot_ada: snapshot_ada,
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference staking_script {
        ref: staking_ref,
    }

    // Spend Staking Manager UTxO (totalStake moves by adjust_amount)
    input manager_input {
        ref: manager_utxo,
        datum_is: StakingDatum,
        redeemer: StakingRedeemer::StUpdateTotalStake {},
    }

    // Spend Staking Position UTxO (adjust the staked amount)
    input position_input {
        ref: position_utxo,
        datum_is: StakingDatum,
        redeemer: StakingRedeemer::StAdjustStakedAmount {
            st_amount: adjust_amount,
        },
    }

    // User provides more INDY (if adding) + fees
    input* source {
        from: User,
        min_amount: fees + indy_change,
    }

    // Updated Staking Manager — totalStake adjusted, snapshot unchanged.
    output manager_output {
        to: StakingScript,
        amount: manager_input,
        datum: StakingDatum::StakingManager {
            sm_content: StakingManagerContent {
                st_total_stake: old_total_stake + adjust_amount,
                st_manager_snapshot: current_snapshot,
            },
        },
    }

    // Updated Staking Position — INDY balance changed, datum preserved.
    output position_output {
        to: StakingScript,
        amount: position_input + indy_change,
        datum: StakingDatum::StakingPosition {
            sp_content: StakingPositionContent {
                st_owner: owner_pkh,
                st_locked_amount: position_locked,
                st_position_snapshot: current_snapshot,
            },
        },
    }

    // User change (receives withdrawn INDY when adjust_amount < 0)
    output {
        to: User,
        amount: source - fees - indy_change,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}

// ============================================================
// 9. UNSTAKE [V3 on-chain — Manager co-spent, position NFT burned]
// ============================================================
// Close a staking position entirely and withdraw all INDY + earned ADA rewards.
// V3 co-spends the Staking Manager (redeemer StUpdateTotalStake) alongside the
// Position (redeemer StUnstake), BURNS the position's STAKING_POSITION NFT, and
// decreases the manager's totalStake by the unstaked amount. The Collector is not
// involved. Confirmed vs on-chain CBOR (e.g. tx 1a16fe01…/bd2d34a4…).
//
// `unstake_amount` is the position's current staked INDY (used to update the
// manager's totalStake); the caller reads it from the position UTxO off-chain.
/// Close a staking position entirely, burning its NFT and withdrawing all staked
/// INDY plus the accrued ADA rewards back to the user.
tx unstake(
    owner_pkh: Bytes,
    manager_utxo: UtxoRef,
    position_utxo: UtxoRef,
    old_total_stake: Int,
    snapshot_ada: Int,
    unstake_amount: Int,
) {
    locals {
        staking_position_nft: AnyAsset(staking_position_policy_id, staking_position_name, 1),
        current_snapshot: RewardSnapshot {
            rs_snapshot_ada: snapshot_ada,
        },
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 600,
    }

    reference staking_script {
        ref: staking_ref,
    }

    reference staking_position_mint_script {
        ref: staking_position_mint_ref,
    }

    // Spend Staking Manager UTxO (totalStake decreases by unstake_amount)
    input manager_input {
        ref: manager_utxo,
        datum_is: StakingDatum,
        redeemer: StakingRedeemer::StUpdateTotalStake {},
    }

    // Spend Staking Position UTxO (consumed entirely)
    input position_input {
        ref: position_utxo,
        datum_is: StakingDatum,
        redeemer: StakingRedeemer::StUnstake {},
    }

    // User provides ADA for fees
    input* source {
        from: User,
        min_amount: fees,
    }

    // Burn the STAKING_POSITION NFT (position is closed)
    burn {
        amount: staking_position_nft,
        redeemer: UnitDatum {},
    }

    // Updated Staking Manager — totalStake reduced, snapshot unchanged.
    output manager_output {
        to: StakingScript,
        amount: manager_input,
        datum: StakingDatum::StakingManager {
            sm_content: StakingManagerContent {
                st_total_stake: old_total_stake - unstake_amount,
                st_manager_snapshot: current_snapshot,
            },
        },
    }

    // User gets back all INDY + the position's ADA (the NFT is burned, not returned).
    output {
        to: User,
        amount: source + position_input - fees - staking_position_nft,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        owner_pkh,
    }
}
