    "adjust_sp_account": {
      "description": "[BLOCKED — tx3 cannot encode the >u64 snapshot decimals it must preserve] Request a\ndeposit to or withdrawal from a Stability Pool account (a batcher processes it).\nPositive amount deposits, negative withdraws.",
      "params": {
        "properties": {
          "account_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "created_at": {
            "type": "integer"
          },
          "deposit_change": {
            "type": "integer"
          },
          "deposits": {
            "items": {
              "items": false,
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/components/schemas/AssetClass"
