        "encoding": "hex",
        "version": "v1beta0"
      }
    },
    "adjust_staking": {
      "description": "Add or remove INDY from an existing staking position. Co-updates the staking\nmanager's total stake. Positive amount deposits INDY, negative withdraws it.",
      "params": {
        "properties": {
          "adjust_amount": {
            "type": "integer"
          },
          "indy_asset_name": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          },
          "manager_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "old_total_stake": {
            "type": "integer"
          },
          "owner_pkh": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          },
          "position_locked": {
            "items": {
              "items": false,
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/components/schemas/LockedEntry"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "position_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "snapshot_ada": {
            "type": "integer"
          }
        },
        "required": [
          "owner_pkh",
          "indy_asset_name",
          "adjust_amount",
          "manager_utxo",
          "position_utxo",
          "old_total_stake",
          "snapshot_ada",
          "position_locked"
        ],
        "type": "object"
      },
      "tir": {
        "content": "",
        "encoding": "hex",
        "version": "v1beta0"
      }
    },
    "borrow_cdp": {
      "description": "Borrow more iAsset against a CDP. Pays the debt-minting fee to the treasury, settles\naccrued interest, and runs the Pyth price check. The caller provides the Pyth message.",
      "params": {
        "properties": {
          "accumulator": {
            "type": "integer"
          },
