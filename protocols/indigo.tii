  "protocol": {
    "name": "indigo",
    "scope": "indigoprotocol",
    "version": "2.0.0"
  },
  "tii": {
    "version": "v1beta0"
  },
  "transactions": {
    "adjust_cdp_burn": {
      "description": "Adjust a CDP by repaying iAsset debt, optionally withdrawing freed ADA collateral.\nSettles accrued interest to the protocol's interest collector.",
      "params": {
        "properties": {
          "accumulator": {
            "type": "integer"
          },
          "burn_amount": {
            "type": "integer"
          },
          "cdp_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "collateral_change": {
            "type": "integer"
          },
          "collector_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "iasset_config_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "iasset_name": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          },
          "iasset_state_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "interest_fee": {
            "type": "integer"
          },
          "minted_change": {
            "type": "integer"
          },
          "new_collateral": {
            "type": "integer"
          },
          "new_minted_total": {
            "type": "integer"
          },
          "oracle_utxo": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/UtxoRef"
          },
          "owner_pkh": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          },
          "price_oracle_idx": {
            "$ref": "#/components/schemas/OracleIdx"
          },
          "timestamp_ms": {
            "type": "integer"
          }
        },
        "required": [
          "owner_pkh",
          "iasset_name",
          "cdp_utxo",
          "collector_utxo",
          "minted_change",
          "collateral_change",
          "burn_amount",
          "interest_fee",
          "new_minted_total",
          "new_collateral",
          "timestamp_ms",
          "accumulator",
          "oracle_utxo",
          "iasset_config_utxo",
