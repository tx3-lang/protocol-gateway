{
  "components": {
    "schemas": {
      "AssetClass": {
        "properties": {
          "ac_name": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          },
          "ac_policy": {
            "$ref": "https://tx3.land/specs/v1beta0/tii#/$defs/Bytes"
          }
        },
        "required": [
          "ac_policy",
          "ac_name"
        ],
        "type": "object"
      },
      "LockedEntry": {
        "properties": {
          "le_end_time": {
            "type": "integer"
          },
          "le_vote_amount": {
            "type": "integer"
          }
        },
        "required": [
          "le_vote_amount",
          "le_end_time"
        ],
        "type": "object"
      },
      "OracleIdx": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "OracleRefInputIdx": {
                "properties": {
                  "ori_idx": {
                    "type": "integer"
                  }
                },
                "required": [
                  "ori_idx"
                ],
                "type": "object"
              }
            },
            "required": [
              "OracleRefInputIdx"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "OracleOutputIdx": {
                "properties": {
                  "oo_idx": {
                    "type": "integer"
                  }
                },
                "required": [
                  "oo_idx"
                ],
                "type": "object"
              }
            },
            "required": [
              "OracleOutputIdx"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "OracleVoid": {
                "properties": {},
                "required": [],
                "type": "object"
              }
            },
            "required": [
              "OracleVoid"
            ],
            "type": "object"
          }
        ]
      },
      "SPDecimal": {
        "properties": {
          "spd_value": {
            "type": "integer"
          }
        },
        "required": [
          "spd_value"
        ],
        "type": "object"
      }
    }
  },
